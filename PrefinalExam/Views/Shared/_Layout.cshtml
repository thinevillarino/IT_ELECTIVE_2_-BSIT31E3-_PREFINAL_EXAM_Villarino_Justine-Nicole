<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Prefinal Exam</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="main-nav">

        <!-- LOGO -->
        <a asp-controller="Home"
           asp-action="Index"
           class="logo-area">

            <div class="logo-holder">

                <img src="@Url.Content("~/images/exam-logo.jpg")"
                     class="site-logo"
                     alt="Prefinal Exam Logo" />

            </div>

            <div class="logo-text">

                <strong>PREFINAL</strong>

                <small>EXAMINATION</small>

            </div>

        </a>


        <!-- NAVIGATION -->
        <div class="top-navigation">

            <a asp-controller="Home"
               asp-action="Index"
               class="top-link">

                Home

            </a>

            <a asp-controller="Home"
               asp-action="Questions"
               asp-route-number="1"
               class="top-link">

                Questions

            </a>

        </div>

    </header>


    <main>
        @RenderBody()
    </main>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>